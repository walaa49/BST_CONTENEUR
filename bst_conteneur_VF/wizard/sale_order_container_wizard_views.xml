<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_container_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.container.wizard.form</field>
        <field name="model">sale.order.container.wizard</field>
        <field name="arch" type="xml">
            <form string="Renseigner le conteneur">
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="container_id"
                           placeholder="Sélectionner un conteneur"/>
                </group>

                <footer>
                    <button name="action_validate"
                            type="object"
                            string="Valider"
                            class="btn-primary"/>

                    <button name="action_cancel"
                            type="object"
                            string="Annuler"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_sale_order_container_wizard" model="ir.actions.act_window">
        <field name="name">Renseigner le conteneur</field>
        <field name="res_model">sale.order.container.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>