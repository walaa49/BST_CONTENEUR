<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_sale_container_list" model="ir.ui.view">
        <field name="name">sale.container.list</field>
        <field name="model">sale.container</field>
        <field name="arch" type="xml">
            <list string="Conteneurs">
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="view_sale_container_form" model="ir.ui.view">
        <field name="name">sale.container.form</field>
        <field name="model">sale.container</field>
        <field name="arch" type="xml">
            <form string="Conteneur">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_sale_container" model="ir.actions.act_window">
        <field name="name">Conteneurs</field>
        <field name="res_model">sale.container</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
        id="menu_sale_container"
        name="Conteneurs"
        parent="sale.menu_sale_config"
        action="action_sale_container"
        sequence="50"
    />

</odoo>